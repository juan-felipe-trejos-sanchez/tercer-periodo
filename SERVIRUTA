Algoritmo ServiRutaExpress
	Definir n,i,tipo Como Entero
	Definir insumos,lubricante,manoObra,total,descuento,totalFinal Como Real
	Definir totalRecaudado,totalDescuentos,promedio Como Real
	Definir motos,autos Como Entero
	totalRecaudado <- 0
	totalDescuentos <- 0
	motos <- 0
	autos <- 0
	Escribir 'Ingrese el numero de vehiculos del turno:'
	Leer n
	Mientras n<=0 Hacer
		Escribir 'Dato no valido. Ingrese un numero mayor que 0:'
		Leer n
	FinMientras
	Para i<-1 Hasta n Hacer
		Escribir 'Vehiculo ',i
		Escribir 'Seleccione el tipo de vehiculo:'
		Escribir '1. Motocicleta'
		Escribir '2. Automovil'
		Leer tipo
		Mientras tipo<>1 Y tipo<>2 Hacer
			Escribir 'Tipo no valido. Ingrese 1 o 2:'
			Leer tipo
		FinMientras
		Si tipo=1 Entonces
			manoObra <- 25000
			motos <- motos+1
		SiNo
			manoObra <- 45000
			autos <- autos+1
		FinSi
		Escribir 'Ingrese el valor de los insumos:'
		Leer insumos
		Mientras insumos<0 Hacer
			Escribir 'Valor no valido. Los insumos no pueden ser negativos:'
			Leer insumos
		FinMientras
		Escribir 'Ingrese el valor del lubricante:'
		Leer lubricante
		Mientras lubricante<0 Hacer
			Escribir 'Valor no valido. El lubricante no puede ser negativo:'
			Leer lubricante
		FinMientras
		total <- manoObra+insumos+lubricante
		Si total>150000 Entonces
			descuento <- total*0.10
		SiNo
			descuento <- 0
		FinSi
		totalFinal <- total-descuento
		totalRecaudado <- totalRecaudado+totalFinal
		totalDescuentos <- totalDescuentos+descuento
	FinPara
	promedio <- totalRecaudado/n
	Escribir '========== REPORTE FINAL =========='
	Escribir 'Total recaudado: $',totalRecaudado
	Escribir 'Motocicletas atendidas: ',motos
	Escribir 'Automoviles atendidos: ',autos
	Escribir 'Total en descuentos: $',totalDescuentos
	Escribir 'Promedio recaudado por vehiculo: $',promedio
FinAlgoritmo
